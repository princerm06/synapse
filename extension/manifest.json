{
    "manifest_version": 3,
    "name": "Synapse",
    "version": "0.1.0",
    "description": "Capture webpages into your Synapse knowledge base.",
    "permissions": [
      "activeTab",
      "scripting"
    ],
    "host_permissions": [
      "http://127.0.0.1:8000/*"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Save to Synapse"
    }
  }