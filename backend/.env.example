# Required: PostgreSQL/Supabase connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Local development defaults to development mode.
# Set this to production in a deployed environment.
APP_ENV=development

# Comma-separated origins allowed to call the API.
# Development may omit this (defaults to *). Production requires explicit values.
# Example:
# CORS_ORIGINS=https://your-frontend.example,chrome-extension://YOUR_EXTENSION_ID
CORS_ORIGINS=
